{
  "info": {
    "_postman_id": "9f8e7d6c-5b4a-4321-8765-1a2b3c4d5e6f",
    "name": "Auth API Tests - Gustavo Brasil",
    "description": "Coleção de testes de caixa cinza na API de autenticação do Supabase (projeto auth-teste-gustavo-brasil) - Gustavo Brasil (RA 252212).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "CT01 Requisição 1 – Login Válido",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"CT01 - Status HTTP é 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"CT01 - Resposta contém access_token e grava no Environment\", function () {",
              "    const jsonData = pm.response.json();",
              "    pm.expect(jsonData).to.be.an(\"object\");",
              "    pm.expect(jsonData.access_token).to.be.a(\"string\").and.not.empty;",
              "    pm.environment.set(\"access_token\", jsonData.access_token);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "apikey",
            "value": "{{api_key}}",
            "type": "text"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{api_key}}",
            "type": "text"
          },
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{base_url}}/auth/v1/token?grant_type=password",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "auth",
            "v1",
            "token"
          ],
          "query": [
            {
              "key": "grant_type",
              "value": "password"
            }
          ]
        }
      },
      "response": []
    },
    {
      "name": "CT02 Requisição 2 – Senha Incorreta",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"CT02 - Status HTTP pertence à classe 4xx\", function () {",
              "    pm.expect(pm.response.code).to.be.within(400, 499);",
              "});",
              "",
              "pm.test(\"CT02 - Resposta contém campo de erro (msg, error_code ou error_description)\", function () {",
              "    const jsonData = pm.response.json();",
              "    pm.expect(jsonData).to.be.an(\"object\");",
              "    const possuiErro = Boolean(jsonData.msg || jsonData.error_code || jsonData.error_description);",
              "    pm.expect(possuiErro).to.be.true;",
              "    pm.expect(jsonData).to.not.have.property(\"access_token\");",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
